{
  "name": "places-api",
  "version": "1.0.2-dev-7",
  "description": "Chrome extension for Places API integration",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc && pwsh ./scripts/copy-static.ps1 && pwsh ./scripts/fix-imports.ps1",
    "watch": "tsc --watch",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/angular": "^1.8.9",
    "@types/chrome": "^0.0.313",
    "@types/google.maps": "^3.58.1",
    "fallow": "^2.96.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.7.3"
  }
}
