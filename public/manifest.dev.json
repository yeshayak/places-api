{
  "manifest_version": 3,
  "name": "P21 Helper Dev",
  "short_name": "P21 Dev",
  "version": "1.0.1",
  "description": "Dev build of P21 Helper for testing Prophet 21 address lookup, Places autocomplete, and workflow automation.",
  "permissions": ["scripting", "storage", "tabs"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://gatorps.prokeep.com https://places.googleapis.com",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' https://maps.googleapis.com; connect-src 'self' https://maps.googleapis.com https://places.googleapis.com;"
  },
  "sandbox": {
    "pages": ["sandbox.html"]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "gator16.png",
      "24": "gator24.png",
      "32": "gator32.png"
    },
    "default_title": "P21 Helper Dev",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "injectKey.js",
        "utils/loadMap.js",
        "autocomplete.js",
        "p21-data-endpoint.js",
        "w_order_entry_sheet.js",
        "w_ship_to_sheet.js",
        "w_customer_maint_sheet.js",
        "w_customer_master_inquiry.js",
        "w_purchase_order_entry_sheet.js",
        "xhr-monitor.js",
        "action-monitor.js",
        "follow-up-requests.js",
        "automation-rules.js",
        "utils/matcher-utils.js",
        "utils/request-parser.js",
        "utils/p21-session.js",
        "utils/userSession.js",
        "utils/duplicateCheck.js",
        "sandbox-autocomplete.js",
        "sandbox.html",
        "sandbox.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
